// Attendance Tracker - Database Schema
// Prefix: tool_attendance_*

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
    output   = "../../../node_modules/@prisma/client-tool-attendance"
}

model tool_attendance_Record {
    id          String    @id @default(uuid())
    userId      String
    date        DateTime  @db.Date
    clockIn     DateTime?
    clockOut    DateTime?
    status      String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY, LEAVE
    totalHours  Float?
    notes       String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@unique([userId, date])
    @@index([userId])
    @@index([date])
    @@map("tool_attendance_records")
}

model tool_attendance_Leave {
    id          String   @id @default(uuid())
    userId      String
    startDate   DateTime @db.Date
    endDate     DateTime @db.Date
    type        String   // SICK, VACATION, PERSONAL, OTHER
    status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
    reason      String?
    createdAt   DateTime @default(now())

    @@index([userId])
    @@map("tool_attendance_leaves")
}
